# Copy to .env and fill in. Never commit .env.
ATLASSIAN_BASE_URL=https://your-tenant.atlassian.net
ATLASSIAN_EMAIL=svc-delivery-copilot@your-company.com
ATLASSIAN_API_TOKEN=
# Custom field ID for "Target Release". Find yours: GET /rest/api/3/field
JIRA_TARGET_RELEASE_FIELD=customfield_XXXXX

# Comma-separated Jira projects to sync at startup, e.g. INS,CLM,PLAT.
# Leave EMPTY to run on the built-in sandbox tenant (app/core/sandbox.py).
# Setting it makes the service read the real tenant; it never mixes the two,
# and a sync that fails serves no findings rather than falling back to sandbox
# data. Run scripts/check_jira_connection.py first.
JIRA_PROJECT_KEYS=

# Needed to answer questions. Without it the service starts, indexes and
# serves approvals, but /ask reports that the key is missing.
ANTHROPIC_API_KEY=

# Let approved actions actually change Jira. Requires the credentials above AND
# project keys — credentials alone never imply permission to write, because a
# tenant is configured for reading first and that day must not be the day the
# service gains the ability to edit tickets.
# Unset/false: the writer is a dry run, and every audit row says so.
# Only "1", "true", "yes" or "on" count as permission.
JIRA_ALLOW_WRITES=

# Evaluate the risk rules as of N days from now. Stale detection needs issues
# that have sat still for weeks, and Jira will not backdate `created`, so a
# freshly seeded sandbox has nothing for it to find. Shifting the clock keeps
# the thresholds honest; lowering them to fit fake data does not.
# Forward only, off by default, and reported by /health and in the UI.
RISK_CLOCK_OFFSET_DAYS=
